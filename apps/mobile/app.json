{
  "expo": {
    "name": "Barbaari",
    "slug": "barbaari-mobile",
    "scheme": "barbaari",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "extra": {
      "apiUrl": "https://api.barbaari.local/api"
    }
  }
}
