APP_NAME=Barbaari
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Production behind a load balancer/reverse proxy: set to its IP/CIDR (comma-separated
# for more than one), or "*" only if you control that proxy end-to-end. Leave blank in
# local/dev. See bootstrap/app.php for why this matters (HSTS, secure cookies, rate-limit
# IP keys all depend on it).
TRUSTED_PROXIES=
DAYCARE_WEB_URL=https://barbaari.pioneeriya.com
FRONTEND_URL=https://barbaari.pioneeriya.com
SUPER_ADMIN_WEB_URL=https://admin-barbaari.pioneeriya.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Primary API auth is Sanctum bearer tokens, not this session cookie — but the session is
# still used for sanctum/csrf-cookie and Laravel's default CSRF machinery. Must be true in
# production (HTTPS); leave false only for local http:// development.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@barbaari.app"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (production email delivery)
# MAIL_MAILER=resend
RESEND_API_KEY=

# Stripe (production payment processing)
STRIPE_MODE=test
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
BILLING_TEST_PAYMENT_ENABLED=false

# Public registration address validation/geocoding
USPS_CONSUMER_KEY=
USPS_CONSUMER_SECRET=
USPS_BASE_URL=https://apis.usps.com
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Automatic timezone detection from geocoded lat/lng. Tried in this order, each skipped
# automatically unless configured — TimeAPI needs no key and is always attempted; adding
# GEONAMES_USERNAME (free, https://www.geonames.org/login) is the cheapest way to add a
# second independent provider so a TimeAPI outage/block never blocks address saves.
TIMEZONE_LOOKUP_BASE_URL=https://www.timeapi.io
GEONAMES_USERNAME=
GEONAMES_BASE_URL=http://api.geonames.org
GOOGLE_TIMEZONE_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
